{
	"name": "pamuk",
	"version": "0.0.1",
	"description": "A fully static blog starter built with SvelteKit and typed Markdown content",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"pamuk": {
		"defaultSite": "demo"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#site/*": "./sites/demo/*",
		"#content-collections": "./.content-collections/generated/index.js"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/finish-build.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && node scripts/check-content.ts && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@content-collections/core": "^0.15.3",
		"@content-collections/integrations": "^0.5.0",
		"@shikijs/rehype": "^4.6.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.19.2",
		"hast-util-to-string": "^3.0.1",
		"image-size": "^2.1.0",
		"mdast-util-directive": "^3.2.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"schema-dts": "^2.1.0",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"vfile": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"zod": "^4.6.7"
	}
}
