# dependencies
/node_modules

# generated by SvelteKit, Vite and content-collections
/.svelte-kit
/.content-collections
vite.config.ts.timestamp-*

# production build (includes the Pagefind index)
/build

# link to the selected site's static folder (scripts/prepare-site.ts)
/static

# unpublished posts, kept out of the public repository
/sites/*/content/drafts/

# testing
/coverage

# local env files
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
